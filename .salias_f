# ai-job-search - Project aliases and functions
# All commands defined here, sourced by .salias
# Run 'help' to see all available commands

# ── Environment ──
set -gx ENV_NAME '.venv'
set -gx PYTHON_VERSION '3.13'

# ── Python Environment ──
alias rmenv='rm -rf .envrc $ENV_NAME uv.lock; exit'
alias mkenv='mkuv $ENV_NAME $PYTHON_VERSION'
# Python deps per README/SETUP (pypdf for the ATS check, openpyxl for the salary
# converter) plus pyyaml for tools/lint_skills.py;
# the portal CLIs get bun install via the repo's own discovery script.
# Stops before installing anything if a required system tool (README
# prerequisites) or the venv is missing, and on the first failed step.
function install
    clear
    set -l missing
    for cmd in uv python3 bun lualatex xelatex
        command -q $cmd; or set -a missing $cmd
    end
    if set -q missing[1]
        echo "install: missing required tools: $missing"
        echo "  uv, python3: Python env   bun: portal CLIs   lualatex, xelatex: TeX Live (texlive)"
        return 1
    end
    if not test -d $ENV_NAME
        echo "install: $ENV_NAME not found - run mkenv first"
        return 1
    end
    uv pip install pip; or return 1
    uv pip install pypdf openpyxl==3.1.5 pyyaml; or return 1
    python3 tools/install_portal_clis.py; or return 1
    command -q pdftotext; or echo "note: pdftotext (poppler) not found - optional ATS-check fallback"
end

# ── Help ──
# Relative path: .salias_f is always sourced with the project dir as PWD.
function help
    clear
    sed "s/PYTHON_VERSION/$PYTHON_VERSION/" ./.salias_help.txt
end
